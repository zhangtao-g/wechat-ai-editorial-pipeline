# ===== 微信公众号 =====
# 二选一：环境变量，或 ~/.hermes/wechat_credentials.json
WECHAT_APPID=
WECHAT_APPSECRET=
# WECHAT_CREDENTIALS_FILE=~/.hermes/wechat_credentials.json

# ===== 运行目录 =====
HERMES_HOME=~/.hermes
AI_NEWS_HOME=~/.hermes/news

# ===== 采集（Horizon）=====
HORIZON_PYTHON=~/.hermes/tools/Horizon/.venv/bin/python

# ===== 封面渲染 =====
# 留空则自动查找 Playwright 缓存 / 系统 Chromium
CHROME_BIN=

# ===== 日报网页版（可选）=====
DAILY_PUBLIC_ROOT=/var/www/ai-daily
DAILY_PUBLIC_BASE=

# ===== 图库（可选，正文配图用）=====
PIXABAY_API_KEY=
